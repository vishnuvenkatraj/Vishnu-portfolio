# ========================================================
# MongoDB Atlas Database Configuration
# ========================================================
# Replace with your actual MongoDB Atlas connection string.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
#
# IMPORTANT:
# - Do NOT commit your actual .env or .env.local file to version control.
# - Keep your credentials confidential.
# ========================================================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# ========================================================
# Real-Time Email Notifications for Contact Form (Optional)
# ========================================================
# Choose either Resend OR Web3Forms to receive emails directly in your Gmail:
#
# Option A: Resend (Free 3,000 emails/mo at https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# Option B: Web3Forms (100% free instant access key from https://web3forms.com)
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Target notification email (defaults to vishnuvenkatraj@gmail.com if unset)
NOTIFICATION_EMAIL=vishnuvenkatraj@gmail.com
